NODE_ENV=development
POSTGRES_IMAGE=postgres:17
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=wasel
DB_USER=wasel
DB_PASSWORD=replace-with-random-password
DB_SYNCHRONIZE=true
JWT_SECRET=replace-with-at-least-32-random-characters
MESSAGE_ENCRYPTION_KEY=replace-with-64-hex-characters
OPENWA_URL=http://127.0.0.1:2785
OPENWA_API_KEY=replace-with-random-key
OPENWA_SESSION_NAME=wasel
MAPBOX_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8090,http://127.0.0.1:8090
# Trusted-server key for POST /api/v1/notifications/send?fcm=... (min 32 chars). Empty disables the endpoint.
NOTIFICATIONS_API_KEY=
# Firebase Admin (server push). Empty project id keeps history-only mode with queued deliveries.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
